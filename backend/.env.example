# API
APP_NAME=RampUp API REST
APP_VERSION=1.0.0
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL (crie o banco e o usuário conforme o README)
DATABASE_URL=postgresql+psycopg2://rampup:rampup_dev@localhost:5432/rampup_db

# Gere um segredo com: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Frontend Vite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
